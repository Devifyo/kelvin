        <changefreq>monthly</changefreq>
        <priority>0.6</priority>
        <image:image>
            <image:loc>https://kevinthompsonphd.com/storage/blog/featured/L4kEbtPHlVfpwIAKa7WUa46AvWIMKPRfwQczFszy.jpg</image:loc>
            <image:title>Thermo Fisher Scientific: Lesson 8</image:title>
            <image:caption>Lesson #8: Hardware organizations generally do not have a direct equivalent to the software Quality Assurance specialist who independently tests most Story deliverables. In many cases, the engineer who creates the deliverable is also the person best qualified to test it.</image:caption>
        </image:image>
    </url>
