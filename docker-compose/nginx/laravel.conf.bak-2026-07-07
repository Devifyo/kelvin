# HTTP redirect to HTTPS
server {
    listen 80;
    server_name kevinthompsonphd.com www.kevinthompsonphd.com;
    return 301 https://$host$request_uri;
}

# HTTPS server
server {
    listen 443 ssl;
    server_name kevinthompsonphd.com www.kevinthompsonphd.com;

    ssl_certificate /etc/letsencrypt/live/kevinthompsonphd.com/fullchain.pem;
    ssl_certificate_key /etc/letsencrypt/live/kevinthompsonphd.com/privkey.pem;

    # Proxy to Laravel Octane running on port 8000 in the 'app' container
    location / {
        proxy_pass http://app:8000;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
    }

    # Proxy to phpMyAdmin running on port 80 in the 'phpmyadmin' container
    location /dbase/ {
        proxy_pass http://phpmyadmin/;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
    }
}
